---
import { getCollection, render } from 'astro:content';
import PageLayout from '@src/layouts/PageLayout.astro';

const pages = await getCollection('pages');
const page  = pages.find((p) => p.id === 'docs');
if (!page) throw new Error('MDX page "docs" not found in src/content/pages/');

const { Content } = await render(page);
---

<!-- Leftover Astromag "Portal theme" placeholder content, not real editorial
     policy despite the footer label. Excluded from the sitemap and marked
     noindex until it's rewritten or the footer link is fixed — see the
     sitemap-readiness report for the full note. -->
<PageLayout page={page} Content={Content} noindex={true} />
