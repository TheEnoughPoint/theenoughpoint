<script is:inline>
/* IRC Chapter 11 Table A — Unified Rate Schedule.
   Verified against IRS Instructions for Form 706 (rev. 09/2025) on 2026-07-18.
   [over, notOver, taxOnColumnA, rateOnExcess] */
const BRACKETS=[[0,10000,0,.18],[10000,20000,1800,.20],[20000,40000,3800,.22],
[40000,60000,8200,.24],[60000,80000,13000,.26],[80000,100000,18200,.28],
[100000,150000,23800,.30],[150000,250000,38800,.32],[250000,500000,70800,.34],
[500000,750000,155800,.37],[750000,1000000,248300,.39],[1000000,null,345800,.40]];
const CREDIT=13000;   // Form 706-NA: maximum unified credit for a non-resident non-citizen

/* ---------------------------------------------------------------
   FX — a single stated constant, not a user input. The tax itself is
   assessed in US dollars, so the rate only affects the S$ presentation;
   making the reader tune it would imply a precision that does not exist.

   Refresh whenever this page is materially updated. The preferred source
   is the MAS daily series (mas.gov.sg/statistics/exchange-rates), which
   was unavailable on both attempts (2026-07-18 and 2026-07-24 — site
   maintenance). This rate is from the US Federal Reserve's H.10 weekly
   release of 20 July 2026, the official US series, quoted for 17 July.
   --------------------------------------------------------------- */
const SGD_PER_USD = 1.2911;                       // Federal Reserve H.10, 17 Jul 2026
const FX_ASOF     = '17 July 2026';
const FX_SOURCE   = 'US Federal Reserve H.10 weekly release';
const FX = 1 / SGD_PER_USD;                       // US$ per S$1 ≈ 0.7745

const $=id=>document.getElementById(id);
const fmt=n=>Math.round(n).toLocaleString('en-US');
function numOf(el){const n=parseFloat(String(el.value).replace(/[^\d.]/g,''));return isFinite(n)?n:0}

function tentative(a){
  for(const [lo,hi,base,rate] of BRACKETS){ if(hi===null||a<=hi) return base+rate*(a-lo); }
  return 0;
}
/* Tax floors at zero — the credit fully shelters anything at or below US$60,000. */
function estateTax(us){ return Math.max(0, tentative(us)-CREDIT); }

function update(){
  const exposedSgd = numOf($('us')), fx = FX;
  $('fx-disp').textContent = 'S$1 = US$'+FX.toFixed(4);
  $('fx-asof').textContent = 'rate as at '+FX_ASOF+' · '+FX_SOURCE;
  const exposedUsd = exposedSgd*fx;
  const taxUsd = estateTax(exposedUsd);
  const taxSgd = fx>0 ? taxUsd/fx : 0;

  $('tax').textContent = 'S$'+fmt(taxSgd);
  $('keep').textContent = 'S$'+fmt(exposedSgd-taxSgd);
  $('d-us').textContent = 'S$'+fmt(taxSgd);
  $('hk-tax').textContent = taxSgd>0 ? 'S$'+fmt(taxSgd) : 'estate-tax';
  const effOnExposed = exposedSgd>0 ? taxUsd/exposedUsd*100 : 0;
  if (exposedSgd<=0){
    $('sub').textContent = 'Nothing held in US-situated assets — nothing to compute.';
    $('fine').textContent = '';
  } else if (taxUsd<=0){
    $('sub').innerHTML = 'You are under the US$60,000 threshold, so nothing is owed. The '
      + 'US$13,000 credit covers a holding this size entirely.';
    $('fine').textContent = 'You hold US$'+fmt(exposedUsd)+' of US-situated assets.';
  } else {
    // one plain sentence carrying all three figures in relation to each other
    $('sub').innerHTML = 'That is <b>'+effOnExposed.toFixed(0)+'%</b> of the <b>S$'+fmt(exposedSgd)
      + '</b> you hold in US shares — settled before your family receives anything.';
    $('fine').textContent = 'Assessed in US dollars: US$'+fmt(taxUsd)+' on US$'+fmt(exposedUsd)+'.';
  }

  // split bar — proportion of the EXPOSED holdings
  const taxPct = exposedSgd>0 ? Math.min(taxSgd/exposedSgd*100,100) : 0;
  $('sp-keep').style.width=(100-taxPct)+'%';
  $('sp-tax').style.width=taxPct+'%';
  $('sp-keep').textContent = taxPct<88 ? (100-taxPct).toFixed(0)+'%' : '';
  $('sp-tax').textContent  = taxPct>7 ? taxPct.toFixed(0)+'%' : '';

  // reference table, with the reader's own band highlighted
  const rows=[60000,100000,250000,500000,1000000,1500000,2000000,3000000];
  let near=null, best=Infinity;
  for(const r of rows){ const d=Math.abs(r-exposedUsd); if(d<best){best=d;near=r} }
  $('tbl').innerHTML = rows.map(r=>{
    const t=estateTax(r);
    return '<tr'+(r===near&&exposedUsd>0?' class="hl"':'')+'><td>US$'+fmt(r)+'</td><td>US$'+fmt(t)+'</td><td>'+(t/r*100).toFixed(1)+'%</td></tr>';
  }).join('');
}

/* Two-way binding, house numeral rules: grouped >= 1,000, so text inputs not number. */
/* ---------------------------------------------------------------
   Eased slider. The track carries positions 0..1000; value = SLIDER_MAX *
   (pos/1000)^2. Squaring puts roughly a quarter of the track under S$300,000,
   which is where the answer is least obvious, while still reaching S$5m at the
   far end. Typing is unbounded — anything larger computes correctly and simply
   pins the thumb, so the cap constrains the drag, never the arithmetic.
   Rounding is adaptive so dragging yields readable figures, not S$247,830.
   --------------------------------------------------------------- */
const SLIDER_MAX = 5_000_000, CURVE = 2;
function roundNice(v){
  const step = v < 100_000 ? 1_000 : v < 1_000_000 ? 5_000 : 25_000;
  return Math.round(v/step)*step;
}
const posToVal = p => roundNice(SLIDER_MAX * Math.pow(p/1000, CURVE));
const valToPos = v => Math.round(1000 * Math.pow(Math.min(v, SLIDER_MAX)/SLIDER_MAX, 1/CURVE));

(() => {
  const t = $('us'), r = $('us-r');
  r.addEventListener('input', () => { t.value = fmt(posToVal(+r.value)); update(); });
  t.addEventListener('input', () => { r.value = valToPos(numOf(t)); update(); });
  t.addEventListener('blur',  () => { t.value = fmt(numOf(t)); update(); });
})();
update();   // pre-computed on first paint
</script>
