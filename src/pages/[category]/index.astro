---
import { getCollection } from 'astro:content';
import CategoryListLayout from '@src/layouts/CategoryListLayout.astro';
import { leafCategories } from '@src/data/pillarsData';

export async function getStaticPaths() {
  const PER_PAGE = 8;

  const allPosts = (await getCollection('blog')).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  const categoryMap = new Map<string, typeof allPosts>();

  for (const post of allPosts) {
    const slug = post.data.category.toLowerCase().replace(/\s+/g, '-');
    if (!categoryMap.has(slug)) categoryMap.set(slug, []);
    categoryMap.get(slug)!.push(post);
  }

  // Every pillar sub-category gets a real page even with zero posts yet,
  // rather than 404ing until the first article is published under it.
  for (const cat of leafCategories) {
    if (!categoryMap.has(cat.id)) categoryMap.set(cat.id, []);
  }

  return [...categoryMap.entries()].map(([slug, posts]) => {
    const totalPages = Math.ceil(posts.length / PER_PAGE);
    const known = leafCategories.find((c) => c.id === slug);
    return {
      params: { category: slug },
      props: {
        pagePosts:    posts.slice(0, PER_PAGE),
        totalPages,
        categoryName: known?.label ?? posts[0]?.data.category ?? slug,
        categorySlug: slug,
        description:  known?.description,
      },
    };
  });
}

interface Props {
  pagePosts:    Awaited<ReturnType<typeof getCollection<'blog'>>>;
  totalPages:   number;
  categoryName: string;
  categorySlug: string;
  description?: string;
}

const { pagePosts, totalPages, categoryName, categorySlug, description } = Astro.props;
---

<CategoryListLayout
  posts={pagePosts}
  currentPage={1}
  totalPages={totalPages}
  categoryName={categoryName}
  categorySlug={categorySlug}
  description={description}
/>
