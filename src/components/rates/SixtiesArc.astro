const GRID = [
  { v: '$250', y: 11.11 },
  { v: '$200', y: 33.33 },
  { v: '$150', y: 55.56 },
  { v: '$100', y: 77.78, base: true },
];
const XT = [
  { v: '1966', x: 6.25 }, { v: '1969', x: 25 }, { v: '1972', x: 43.75 },
  { v: '1975', x: 62.5 }, { v: '1978', x: 81.25 }, { v: '1981', x: 100 },
];
---

<div class="sa">
  <div class="sa-head">
    <span class="sa-lbl">Where could you have hidden, 1966&ndash;1981?</span>
    <span class="sa-sub">What $100 became &middot; Dec 1965 &ndash; Dec 1981</span>
  </div>

  <div class="sa-key">
    <span class="sa-k"><i class="sa-sw nom"></i>shares, on paper</span>
    <span class="sa-k"><i class="sa-sw real"></i>shares, after inflation</span>
    <span class="sa-k"><i class="sa-sw bond"></i>10-year Treasuries, after inflation</span>
  </div>

  <div class="sa-body">
    <div class="sa-chart">
      <div class="sa-ycol" aria-hidden="true">
        {GRID.map((g) => (
          <span class={g.base ? 'is-base' : ''} style={`top:${g.y}%`}>{g.v}</span>
        ))}
      </div>
      <div class="sa-plot" role="img"
           aria-label="Three lines from the same $100 in December 1965. Shares on paper grow unevenly to $253 by December 1981. Shares after inflation climb to about $120 by 1972, fall to $60 in the 1974 bear, and end at $85.50 — below the $100 they started from. Rolled 10-year Treasuries after inflation grind steadily down to $63, the worst of the three.">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {GRID.map((g) => (
            <line x1="0" y1={g.y} x2="100" y2={g.y}
                  stroke={g.base ? '#55606E' : '#E3DDCF'} stroke-width="1"
                  stroke-dasharray={g.base ? '3 3' : 'none'} vector-effect="non-scaling-stroke" />
          ))}
          <polyline points={BOND} fill="none" stroke="#55606E" stroke-width="1.75"
                    stroke-dasharray="3.5 3" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          <polyline points={NOMINAL} fill="none" stroke="#8A6520" stroke-width="2.5"
                    stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          <polyline points={REAL} fill="none" stroke="#0B1D33" stroke-width="2.5"
                    stroke-linejoin="round" vector-effect="non-scaling-stroke" />
        </svg>
        <i class="sa-tr-dot" style="left:56.25%;top:95.37%" aria-hidden="true"></i>
        <i class="sa-tr-lead" style="left:56.25%;top:86%;height:8%" aria-hidden="true"></i>
        <span class="sa-trough" style="left:56.25%;top:85.5%">shares&rsquo; 1974 low: $60</span>
      </div>
      <div class="sa-endcol" aria-hidden="true">
        <span class="sa-endv nom" style="top:9.89%"><b>$253</b>on paper</span>
        <span class="sa-endv real" style="top:84.22%"><b>$85.50</b>shares, real</span>
        <span class="sa-endv bond" style="top:94.16%"><b>$63</b>bonds, real</span>
      </div>
      <div class="sa-x">
        {XT.map((t, i) => (
          <span style={`left:${t.x}%`} class={i === XT.length - 1 ? 'is-last' : ''}>{t.v}</span>
        ))}
      </div>
    </div>
  </div>

  <div class="sa-out">
    <p class="sa-out-s">
      The statement said <b>$253</b>; the supermarket said <b>$85.50</b>. The
      &ldquo;safe&rdquo; 10-year bond kept <b>$63</b>, and cash T-bills, rolled the whole
      way, <b>$97.50</b> &mdash; standing still. In the one regime that truly hurt
      shares, the fear&rsquo;s favourite shelter was the biggest casualty.
    </p>
  </div>

  <div class="sa-notes">
    <p>
      What $100 became, monthly, all after inflation except the gold line; shares
      reinvest dividends. The dashed line rolls a 10-year par Treasury each month at
      FRED&rsquo;s GS10 yield, coupon accrued &mdash; an independent year-end
      construction (Damodaran&rsquo;s annual series) compounds to about $60, same story.
      T-bills are Ken French&rsquo;s one-month series. Shares and CPI from Shiller
      (Yale). December 1965 to December 1981. Endpoints re-derivable with the script
      in the fold below. Our computation.
    </p>
    <ToolBrand />
  </div>
</div>

<style is:global>
.sa{
  --sa-bd:var(--color-border); --sa-t1:var(--color-dark); --sa-t2:var(--color-body);
  --sa-nom:#8A6520; --sa-real:#0B1D33; --sa-deep:var(--color-navy);
  --sa-mono:var(--font-mono),'SF Mono',Menlo,Consolas,monospace;
  background:#fff;border:1px solid var(--sa-bd);border-radius:12px;
  box-shadow:0 4px 6px rgba(0,0,0,.05),0 2px 4px rgba(0,0,0,.04);
  overflow:hidden;margin:26px 0;color:var(--sa-t1)
}
.sa-head{padding:14px 20px;background:var(--color-surface);border-bottom:1px solid var(--sa-bd)}
.sa-lbl{display:block;font-size:14.5px;font-weight:700;letter-spacing:-.1px;color:var(--sa-t1)}
.sa-sub{display:block;margin-top:4px;font-size:11.5px;font-weight:600;
  text-transform:uppercase;letter-spacing:.8px;color:var(--sa-t2)}
.sa-key{display:flex;flex-wrap:wrap;gap:7px 18px;padding:11px 20px;border-bottom:1px dashed var(--sa-bd)}
.sa-k{display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--sa-t2)}
.sa-sw{width:18px;height:4px;border-radius:2px;flex:none;display:inline-block}
.sa-sw.nom{background:var(--sa-nom)}
.sa-sw.real{background:var(--sa-real)}
.sa-sw.bond{background:repeating-linear-gradient(90deg,#55606E 0 5px,transparent 5px 9px)}
.sa-body{padding:16px 20px 6px}
/* Axis and end labels live in their own gutters, outside the plot, so they can
   never sit on ink — the in-plot version collided with the lines' shared
   starting point and escaped the box at phone widths. The x-label row is a
   second grid row pinned to the plot column so its percentages stay aligned. */
.sa-chart{display:grid;grid-template-columns:44px minmax(0,1fr) 96px;
  grid-template-rows:auto auto;column-gap:6px}
.sa-ycol{grid-area:1/1;position:relative}
.sa-ycol span{position:absolute;right:2px;transform:translateY(-50%);
  font-family:var(--sa-mono);font-size:11px;color:var(--color-muted);
  font-variant-numeric:tabular-nums;white-space:nowrap}
.sa-ycol span.is-base{color:var(--sa-t1);font-weight:700}
/* min-height 270, not 230: the shares-real and bonds-real gutter labels sit
   ten points apart, and a shorter phone plot pressed them into each other. */
.sa-plot{grid-area:1/2;position:relative;width:100%;aspect-ratio:8/5;min-height:270px;
  background:linear-gradient(#FBFAF7,#fff);border:1px solid var(--sa-bd);border-radius:8px;
  overflow:hidden}
.sa-plot svg{position:absolute;inset:0;width:100%;height:100%}
.sa-endcol{grid-area:1/3;position:relative}
.sa-endv{position:absolute;left:0;transform:translateY(-50%);line-height:1.2;
  font-size:11.5px;font-weight:600;border-left:3px solid;padding-left:7px;
  white-space:nowrap}
.sa-endv b{display:block;font-family:var(--sa-mono);font-size:16px;font-weight:700;
  font-variant-numeric:tabular-nums}
.sa-endv.nom{color:var(--sa-nom);border-color:var(--sa-nom)}
.sa-endv.real{color:var(--sa-real);border-color:var(--sa-real)}
/* Muted slate is the token already tuned to clear 4.5:1 on white. */
.sa-endv.bond{color:var(--color-muted);border-color:var(--color-muted)}
/* The 1974 annotation anchors to its point: a dot on the after-inflation
   line's low, a hairline leader, and the label above — floating text with no
   anchor read as a mystery caption. HTML dot, not SVG: a circle inside the
   stretched viewBox would render as an ellipse. Hidden on narrow screens,
   where it crowds the plot; the aria narration carries the $60 fact. */
@media (max-width:520px){.sa-trough,.sa-tr-dot,.sa-tr-lead{display:none}}
.sa-tr-dot{position:absolute;width:9px;height:9px;border-radius:50%;
  background:var(--sa-real);border:2px solid #fff;transform:translate(-50%,-50%);
  box-shadow:0 0 0 1px rgba(11,29,51,.25)}
.sa-tr-lead{position:absolute;width:1.5px;background:var(--color-muted);
  transform:translateX(-50%);opacity:.55}
.sa-trough{position:absolute;transform:translate(-50%,-100%);font-size:11px;
  color:var(--color-muted);background:rgba(255,255,255,.85);padding:0 4px;
  border-radius:3px;white-space:nowrap}
.sa-x{grid-area:2/2;position:relative;height:22px;margin-top:4px}
.sa-x span{position:absolute;top:2px;transform:translateX(-50%);font-family:var(--sa-mono);
  font-size:11px;color:var(--color-muted)}
.sa-x span.is-last{transform:translateX(-100%)}
/* Phone: slim both gutters, let the end sublabels wrap, and drop every other
   year tick — six labels collide across a ~220px plot. */
@media (max-width:520px){
  .sa-chart{grid-template-columns:36px minmax(0,1fr) 64px;column-gap:4px}
  .sa-endv{white-space:normal;font-size:11px;padding-left:5px}
  .sa-endv b{font-size:14px}
  /* The shares-real and bonds-real ends sit ten points apart; on a 270px plot
     their centred labels kiss, so each shifts a quarter-box away from the other. */
  .sa-endv.real{transform:translateY(-75%)}
  .sa-endv.bond{transform:translateY(-25%)}
  .sa-x span:nth-child(2),.sa-x span:nth-child(4){display:none}
}
.sa-out{background:var(--sa-deep);color:#fff;padding:17px 20px}
