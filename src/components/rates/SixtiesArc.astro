const GRID = [
  { v: '$2.50', y: 11.11 },
  { v: '$2', y: 33.33 },
  { v: '$1.50', y: 55.56 },
  { v: '$1', y: 77.78, base: true },
];
const XT = [
  { v: '1966', x: 6.25 }, { v: '1969', x: 25 }, { v: '1972', x: 43.75 },
  { v: '1975', x: 62.5 }, { v: '1978', x: 81.25 }, { v: '1981', x: 100 },
];
---

<div class="sa">
  <div class="sa-head">
    <span class="sa-lbl">The same sixteen years, two truths</span>
    <span class="sa-sub">Growth of $1 in US shares, dividends reinvested &middot; Dec 1965 &ndash; Dec 1981</span>
  </div>

  <div class="sa-key">
    <span class="sa-k"><i class="sa-sw nom"></i>on paper (before inflation)</span>
    <span class="sa-k"><i class="sa-sw real"></i>in purchasing power (after inflation)</span>
  </div>

  <div class="sa-body">
    <div class="sa-plot" role="img"
         aria-label="Two lines from the same $1 in December 1965. On paper the dollar grows unevenly to $2.53 by December 1981. After inflation it climbs to about $1.20 by 1972, falls to 60 cents in the 1974 bear, and ends at 86 cents — below the dollar it started from.">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {GRID.map((g) => (
          <line x1="0" y1={g.y} x2="100" y2={g.y}
                stroke={g.base ? '#55606E' : '#E3DDCF'} stroke-width="1"
                stroke-dasharray={g.base ? '3 3' : 'none'} vector-effect="non-scaling-stroke" />
        ))}
        <polyline points={NOMINAL} fill="none" stroke="#8A6520" stroke-width="2.5"
                  stroke-linejoin="round" vector-effect="non-scaling-stroke" />
        <polyline points={REAL} fill="none" stroke="#0B1D33" stroke-width="2.5"
                  stroke-linejoin="round" vector-effect="non-scaling-stroke" />
      </svg>
      {GRID.map((g) => (
        <span class={`sa-yl ${g.base ? 'is-base' : ''}`} style={`top:${g.y}%`}>{g.v}</span>
      ))}
      <span class="sa-end nom" style="top:9.89%">$2.53 on paper</span>
      <span class="sa-end real" style="top:84.22%">$0.86 after inflation</span>
      <span class="sa-trough" style="left:56.25%;top:89%">Dec 1974: $0.60</span>
    </div>
    <div class="sa-x">
      {XT.map((t, i) => (
        <span style={`left:${t.x}%`} class={i === XT.length - 1 ? 'is-last' : ''}>{t.v}</span>
      ))}
    </div>
  </div>

  <div class="sa-out">
    <p class="sa-out-s">
      <b>+153%</b> on paper. <b>&minus;15%</b> in purchasing power. Same shares, same
      sixteen years &mdash; the difference between the two lines is inflation, and
      nobody&rsquo;s statement ever showed the second one.
    </p>
  </div>

  <div class="sa-notes">
    <p>
      Growth of $1, dividends reinvested, monthly. The lower line deflates the same
      series by US CPI. Shiller data (Yale), December 1965 to December 1981. Endpoints
      re-derivable with the script in the fold below. Our computation.
    </p>
    <ToolBrand />
  </div>
</div>

<style is:global>
.sa{
  --sa-bd:var(--color-border); --sa-t1:var(--color-dark); --sa-t2:var(--color-body);
  --sa-nom:#8A6520; --sa-real:#0B1D33; --sa-deep:var(--color-navy);
  --sa-mono:var(--font-mono),'SF Mono',Menlo,Consolas,monospace;
  background:#fff;border:1px solid var(--sa-bd);border-radius:12px;
  box-shadow:0 4px 6px rgba(0,0,0,.05),0 2px 4px rgba(0,0,0,.04);
  overflow:hidden;margin:26px 0;color:var(--sa-t1)
}
.sa-head{padding:14px 20px;background:var(--color-surface);border-bottom:1px solid var(--sa-bd)}
.sa-lbl{display:block;font-size:14.5px;font-weight:700;letter-spacing:-.1px;color:var(--sa-t1)}
.sa-sub{display:block;margin-top:4px;font-size:11.5px;font-weight:600;
  text-transform:uppercase;letter-spacing:.8px;color:var(--sa-t2)}
.sa-key{display:flex;flex-wrap:wrap;gap:7px 18px;padding:11px 20px;border-bottom:1px dashed var(--sa-bd)}
.sa-k{display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--sa-t2)}
.sa-sw{width:18px;height:4px;border-radius:2px;flex:none;display:inline-block}
.sa-sw.nom{background:var(--sa-nom)}
.sa-sw.real{background:var(--sa-real)}
.sa-body{padding:16px 20px 6px}
.sa-plot{position:relative;width:100%;aspect-ratio:8/5;min-height:230px;
  background:linear-gradient(#FBFAF7,#fff);border:1px solid var(--sa-bd);border-radius:8px;
  overflow:hidden}
.sa-plot svg{position:absolute;inset:0;width:100%;height:100%}
.sa-yl{position:absolute;left:7px;transform:translateY(-55%);font-family:var(--sa-mono);
  font-size:11px;color:var(--color-muted);background:rgba(255,255,255,.85);
  padding:0 4px;border-radius:3px;font-variant-numeric:tabular-nums}
.sa-yl.is-base{color:var(--sa-t1);font-weight:700}
.sa-end{position:absolute;right:7px;font-size:12px;font-weight:700;
  background:rgba(255,255,255,.9);padding:1px 6px;border-radius:4px;white-space:nowrap}
/* Both labels sit just below their line-ends: above, the nominal one escaped
   the plot box at phone widths. The white pill keeps them legible over ink. */
.sa-end.nom{color:var(--sa-nom);transform:translateY(20%)}
.sa-end.real{color:var(--sa-real);transform:translateY(35%)}
/* The 1974 trough note is garnish; at phone widths it collides with the real
   end label, and the aria narration already carries the 60-cent fact. */
@media (max-width:520px){.sa-trough{display:none}}
.sa-trough{position:absolute;transform:translate(-50%,-100%);font-size:11px;
  color:var(--color-muted);background:rgba(255,255,255,.85);padding:0 4px;
  border-radius:3px;white-space:nowrap}
.sa-x{position:relative;height:22px;margin-top:4px}
.sa-x span{position:absolute;top:2px;transform:translateX(-50%);font-family:var(--sa-mono);
  font-size:11px;color:var(--color-muted)}
.sa-x span.is-last{transform:translateX(-100%)}
.sa-out{background:var(--sa-deep);color:#fff;padding:17px 20px}
.post-content .sa-out-s{font-size:15px;line-height:1.62;color:#D8DEE8;margin:0}
.sa-out-s b{font-family:var(--sa-mono);font-weight:600;color:#fff}
.sa-notes{padding:14px 20px 15px;border-top:1px solid var(--sa-bd);background:var(--color-surface)}
.post-content .sa-notes p{font-size:12px;line-height:1.5;color:var(--color-muted);margin:0 0 8px}
</style>
