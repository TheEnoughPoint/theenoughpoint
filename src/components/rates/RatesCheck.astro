.rc-a-tw th{background:var(--color-surface);font-weight:700;font-size:12px;color:var(--rca-t1)}
.rc-a-tw td{font-family:var(--rca-mono);color:var(--rca-t1);font-variant-numeric:tabular-nums}
.rc-a-tw td:first-child{font-family:inherit}
.rc-a-tw tbody tr:last-child td{border-bottom:0}
.post-content .rc-a-note{font-size:12px;line-height:1.5;color:var(--rca-t2);margin:0 0 6px}
