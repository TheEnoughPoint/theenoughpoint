  overflow:hidden;margin:26px 0;color:var(--rca-t1)
}
.rc-a-head{padding:14px 20px;background:var(--color-surface);border-bottom:1px solid var(--rca-bd)}
.rc-a-lbl{display:block;font-size:14.5px;font-weight:700;color:var(--rca-t1)}
.rc-a-sub{display:block;margin-top:3px;font-size:11.5px;font-weight:600;
  text-transform:uppercase;letter-spacing:.8px;color:var(--rca-t2)}
.rc-a-body{padding:16px 20px 6px}
.post-content .rc-a-lead{font-size:14px;line-height:1.6;color:var(--rca-t2);margin:0 0 14px}
