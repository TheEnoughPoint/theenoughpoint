---
// How much of the time were you underwater, and by how much.
//
// This is the answer to "it returned 65% a year, so what is the problem" — the
// problem is that almost nobody sits through the path required to collect it.
// Computed by us from daily adjusted closes, July 2010 to July 2026: for each
// trading day, how far below its own running high the fund was.
//
// Green/red here encode a single quantity's severity, not two entities, so the
// semantic palette is correct. The index bars are shown beside each leveraged
// fund so the reader sees this is a property of the wrapper, not of the market.
const ROWS = [
  { name: 'SOXL', sub: '3× semiconductors', d30: 52.6, d50: 31.6, worst: -90.5, lev: true },
  { name: 'SOXX', sub: 'the plain index fund', d30: 3.7,  d50: 0.0,  worst: -45.8, lev: false },
  { name: 'TQQQ', sub: '3× Nasdaq-100',     d30: 21.0, d50: 10.7, worst: -81.7, lev: true },
  { name: 'QQQ',  sub: 'the plain index fund', d30: 1.5,  d50: 0.0,  worst: -35.1, lev: false },
];
---

<figure class="dd">
  <figcaption class="dd-cap">
    <h4>How much of the time you were deeply underwater</h4>
    <p>Share of all trading days spent more than 30% below the fund&rsquo;s own previous high,
    July 2010 to July 2026. The darker block is the portion spent more than 50% below.</p>
  </figcaption>

  <div class="dd-plot">
    {ROWS.map((r) => (
      <div class:list={['dd-row', r.lev ? 'is-lev' : 'is-idx']}>
        <div class="dd-name"><b>{r.name}</b><span>{r.sub}</span></div>
        <div class="dd-track">
          <div class="dd-bar" style={`width:${r.d30}%`}>
            <div class="dd-deep" style={`width:${r.d30 ? (r.d50 / r.d30) * 100 : 0}%`}></div>
          </div>
          <span class="dd-val" style={`left:calc(${r.d30}% + 8px)`}>{r.d30.toFixed(1)}%</span>
        </div>
        <div class="dd-worst">worst fall <b>{r.worst.toFixed(0)}%</b></div>
      </div>
    ))}
  </div>

  <p class="dd-foot">The 3× semiconductor fund returned <b>65.9% a year</b> over the decade to
  June 2026 — and spent <b>a third of the whole period</b> worth less than half what it had been.
  Both are true. Only one appears in a performance table.</p>
</figure>

<style is:global>
.dd{
  --dd-mid:#C8863C; --dd-deep:#A93226;
  --dd-rule:var(--color-border); --dd-ink:var(--color-dark);
  --dd-body:var(--color-body); --dd-muted:var(--color-muted);
  --dd-mono:var(--font-mono),'SF Mono',Menlo,Consolas,monospace;
  margin:26px 0;padding:20px 22px 16px;background:#fff;
  border:1px solid var(--dd-rule);border-radius:12px
}
@media (prefers-color-scheme: dark){ .dd{ --dd-mid:#D89A55; --dd-deep:#E08074; } }
.post-content .dd-cap{margin:0 0 16px;padding:0;text-align:left}
.post-content .dd-cap h4{margin:0 0 3px;font-size:15.5px;font-weight:700;color:var(--dd-ink);
  font-family:var(--font-body);letter-spacing:0}
.post-content .dd-cap p{margin:0;font-size:12.5px;color:var(--dd-muted);line-height:1.5}

.dd-plot{display:flex;flex-direction:column;gap:10px}
.dd-row{display:grid;grid-template-columns:118px 1fr 108px;gap:10px;align-items:center}
.dd-row.is-idx{opacity:.75}
.dd-name{display:flex;flex-direction:column;line-height:1.25}
.dd-name b{font-size:13.5px;color:var(--dd-ink);font-weight:700}
.dd-name span{font-size:11px;color:var(--dd-muted)}
.dd-track{position:relative;height:22px;padding-right:46px}
.dd-bar{position:absolute;top:3px;height:16px;background:var(--dd-mid);border-radius:0 3px 3px 0;
  min-width:2px;transition:width .4s ease}
.dd-deep{height:100%;background:var(--dd-deep);border-radius:0 0 0 0}
.dd-val{position:absolute;top:4px;font-family:var(--dd-mono);font-variant-numeric:tabular-nums;
  font-size:12.5px;font-weight:600;color:var(--dd-ink);white-space:nowrap}
.dd-worst{font-size:11.5px;color:var(--dd-muted);text-align:right;white-space:nowrap}
.dd-worst b{font-family:var(--dd-mono);color:var(--dd-deep);font-weight:600}

.post-content .dd-foot{font-size:14px;color:var(--dd-body);line-height:1.6;margin:16px 0 0}
.dd-foot b{color:var(--dd-ink);font-weight:600}

@media(max-width:620px){
  .dd{padding:16px 13px 13px}
  .dd-row{grid-template-columns:1fr 84px;grid-template-areas:'name worst' 'track track';gap:4px 8px}
  .dd-name{grid-area:name}
  .dd-worst{grid-area:worst}
  .dd-track{grid-area:track;margin-bottom:4px}
}
</style>
