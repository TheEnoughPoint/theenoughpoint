  --cmp-bad:#a8231c;  --cmp-bad-wash:#FBEDED;
  --cmp-ink:var(--color-dark); --cmp-body:var(--color-body); --cmp-muted:var(--color-muted);
  --cmp-rule:var(--color-border); --cmp-soft:#F0ECE2;
