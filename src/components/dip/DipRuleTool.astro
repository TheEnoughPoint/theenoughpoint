<div class="dip-t" id="dip-t">
  <div class="dip-t-head">
    <span class="dip-t-lbl">Set your own rule</span>
    <span class="dip-t-lbl accent">and see what it would have done</span>
  </div>

  <div class="dip-t-controls">
  <div class="dip-t-row">
    <span class="dip-t-lab" id="lab-mk">You are buying</span>
    <div class="dip-t-seg" data-k="mk" role="group" aria-labelledby="lab-mk"><button type="button" data-v="us" class="on" aria-pressed="true">US shares</button><button type="button" data-v="dm" aria-pressed="false">Developed</button><button type="button" data-v="em" aria-pressed="false">Emerging</button><button type="button" data-v="sg" aria-pressed="false">Singapore</button></div>
  </div>
  <div class="dip-t-row">
    <span class="dip-t-lab" id="lab-dp">You wait for a fall of</span>
    <div class="dip-t-seg" data-k="dp" role="group" aria-labelledby="lab-dp"><button type="button" data-v="5" aria-pressed="false">5%</button><button type="button" data-v="10" aria-pressed="false">10%</button><button type="button" data-v="15" class="on" aria-pressed="true">15%</button><button type="button" data-v="20" aria-pressed="false">20%</button></div>
  </div>
  <div class="dip-t-row">
    <span class="dip-t-lab" id="lab-dl">Before giving up you allow</span>
    <div class="dip-t-seg" data-k="dl" role="group" aria-labelledby="lab-dl"><button type="button" data-v="12" aria-pressed="false">1 year</button><button type="button" data-v="24" class="on" aria-pressed="true">2 years</button><button type="button" data-v="36" aria-pressed="false">3 years</button></div>
  </div>
  <div class="dip-t-row">
    <span class="dip-t-lab" id="lab-rt">Your waiting cash earns</span>
    <div class="dip-t-seg" data-k="rt" role="group" aria-labelledby="lab-rt"><button type="button" data-v="0" class="on" aria-pressed="true">nothing</button><button type="button" data-v="2" aria-pressed="false">2% a year</button><button type="button" data-v="4" aria-pressed="false">4% a year</button></div>
  </div>
  </div>

  <div class="dip-t-out" aria-live="polite">
    <div class="dip-t-cell">
      <div class="dip-t-num" id="dip-o1">&mdash;</div>
      <div class="dip-t-cap">of the time the fall actually arrived</div>
    </div>
    <div class="dip-t-cell">
      <div class="dip-t-num" id="dip-o2">&mdash;</div>
      <div class="dip-t-cap">typical wait when it did</div>
    </div>
    <div class="dip-t-cell">
      <div class="dip-t-num" id="dip-o3">&mdash;</div>
      <div class="dip-t-cap">of the time investing on day one still won</div>
    </div>
  </div>

  <div class="dip-t-say"><p id="dip-os"></p></div>

  <div class="dip-t-notes">
    <p id="dip-on"></p>
    <ToolBrand />
  </div>
</div>

<script is:inline define:vars={{ DATA }}>
  (function () {
    var S = {"mk":"us","dp":"15","dl":"24","rt":"0"};
    var root = document.getElementById('dip-t');
    if (!root) return;
    function pct(n) { return Math.round(n) + '%'; }
    function up() {
      var c = DATA.cells[S.mk + '|' + S.dp + '|' + S.dl + '|' + S.rt];
      if (!c) return;
      document.getElementById('dip-o1').textContent = pct(c.arrived);
      document.getElementById('dip-o2').textContent = c.wait ? c.wait + ' mo' : 'n/a';
      document.getElementById('dip-o3').textContent = pct(c.nowWon);
      var never = Math.round(100 - c.arrived);
      var yrs = S.dl / 12;
      document.getElementById('dip-os').innerHTML =
        'Waiting for a <b>' + S.dp + '%</b> fall in ' + DATA.short[S.mk] + ', giving it ' +
        yrs + (yrs === 1 ? ' year' : ' years') + ': the fall never arrived <b>' + never +
        '%</b> of the time, and investing on day one still came out ahead <b>' +
        pct(c.nowWon) + '</b> of the time.';
      var note = 'Based on ' + c.n.toLocaleString('en-SG') + ' starting months of ' +
        DATA.markets[S.mk] + '. Outcomes compared ' + c.horizon +
        ' months after the money arrived; if the fall never came, the money went in at the ' +
        'deadline regardless. Our computation.';
      if (S.mk === 'sg') note += ' The Singapore index carries no dividend data before 2008, ' +
        'so a 2.6% yield is assumed; the dip figures move materially with that assumption. ' +
        'Treat them as directional.';
      document.getElementById('dip-on').textContent = note;
    }
    root.querySelectorAll('.dip-t-seg').forEach(function (g) {
      g.addEventListener('click', function (e) {
        var b = e.target.closest('button');
        if (!b || !g.contains(b)) return;
        g.querySelectorAll('button').forEach(function (x) {
          x.classList.remove('on'); x.setAttribute('aria-pressed', 'false');
        });
        b.classList.add('on'); b.setAttribute('aria-pressed', 'true');
        S[g.dataset.k] = b.dataset.v;
        up();
      });
    });
    up();
  })();
</script>

<style is:global>
.dip-t{
  --dt-bd:var(--color-border); --dt-t1:var(--color-dark); --dt-t2:var(--color-body);
  --dt-t3:var(--color-muted); --dt-deep:var(--color-navy);
  --dt-mono:var(--font-mono),'SF Mono',Menlo,Consolas,monospace;
  background:#fff;border:1px solid var(--dt-bd);border-radius:12px;
  box-shadow:0 4px 6px rgba(0,0,0,.05),0 2px 4px rgba(0,0,0,.04);
  overflow:hidden;margin:26px 0;color:var(--dt-t1)
}
.dip-t-head{padding:14px 20px;background:var(--color-surface);border-bottom:1px solid var(--dt-bd);
  display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.dip-t-lbl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--dt-t3)}
.dip-t-lbl.accent{color:var(--color-brand-700)}
.dip-t-controls{padding:16px 20px 6px}
.dip-t-row{display:flex;flex-direction:column;gap:7px;margin-bottom:14px}
.dip-t-lab{font-size:11px;font-weight:700;letter-spacing:.9px;text-transform:uppercase;color:var(--dt-t3)}
.dip-t-seg{display:flex;flex-wrap:wrap;gap:7px}
.dip-t-seg button{font-family:inherit;font-size:13.5px;padding:9px 13px;min-height:44px;
  border:1px solid var(--dt-bd);background:#fff;color:var(--dt-t2);border-radius:7px;cursor:pointer}
.dip-t-seg button:hover{border-color:var(--color-brand-700);color:var(--color-brand-700)}
.dip-t-seg button.on{background:var(--color-brand-700);border-color:var(--color-brand-700);
  color:#fff;font-weight:700}
