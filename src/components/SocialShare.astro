---
import { Icon } from 'astro-icon/components';

interface Props {
  title?: string;
  pageUrl?: string;
  prompt?: string;
}

const {
  // Optional with a safe default, deliberately. Four articles called this
  // component bare and every share text began with the word "undefined" —
  // caught in a real WhatsApp compose box, 22 Aug 2026. With no title the
  // links now carry just the URL, and the script below upgrades them from
  // document.title on load.
  title = '',
  pageUrl = Astro.url.href,
  // A labelled ask, not a bare row of glyphs. Unlabelled icons in a corner read
  // as page furniture and get skipped; naming the action is the single biggest
  // difference between a share row that gets used and one that does not.
  prompt = 'Found this useful? Pass it on.',
} = Astro.props;

const encoded = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(title);
const waText = encodeURIComponent(title ? `${title} ${pageUrl}` : pageUrl);
const mailSubject = encodeURIComponent(title || 'Worth a read');
const mailBody = title ? `${encodedTitle}%0A%0A${encoded}` : encoded;

// Ordered for a Singapore readership rather than alphabetically or by global
// market share: WhatsApp and Telegram are how this audience actually forwards
// things, LinkedIn carries the professional finance reach, and Facebook is the
// weakest of the set for this kind of content.
//
// Instagram is deliberately absent. There is no web share endpoint for it and
// never has been — Meta only permits sharing to Stories from a native app via
// their SDK. The OS share sheet behind the native button below is the only
// route to Instagram from a web page, and it covers it.
//
// These are plain links, not the official Facebook/X SDK widgets. The widgets
// inject third-party tracking into every article, which would contradict what
// the site tells readers about carrying no advertising.
const shares = [
  {
    icon:  'bi:whatsapp',
    label: 'Share on WhatsApp',
    href:  `https://api.whatsapp.com/send?text=${waText}`,
  },
  {
    icon:  'bi:telegram',
    label: 'Share on Telegram',
    href:  `https://t.me/share/url?url=${encoded}${title ? `&text=${encodedTitle}` : ''}`,
  },
  {
    // share-offsite is LinkedIn's current endpoint; the older shareArticle one
    // is deprecated. It takes no title — LinkedIn reads the page's OG tags.
    icon:  'bi:linkedin',
    label: 'Share on LinkedIn',
    href:  `https://www.linkedin.com/sharing/share-offsite/?url=${encoded}`,
  },
  {
    icon:  'bi:twitter-x',
    label: 'Share on X',
    href:  `https://x.com/intent/post?url=${encoded}${title ? `&text=${encodedTitle}` : ''}`,
  },
  {
    icon:  'bi:facebook',
    label: 'Share on Facebook',
    href:  `https://www.facebook.com/sharer/sharer.php?u=${encoded}`,
  },
  {
    // Long reads get forwarded to a spouse or an accountant. mailto works
    // everywhere and needs no third party.
    icon:  'bi:envelope-fill',
    label: 'Share by email',
    href:  `mailto:?subject=${mailSubject}&body=${mailBody}`,
  },
];
---

<div class="ts-share" data-share data-share-url={pageUrl} data-share-title={title}>
  <p class="ts-prompt">{prompt}</p>

  <div class="ts-row">
    {/* Native OS share sheet. Hidden until the script confirms support, because
        on iOS and Android it is the only route to Instagram, Messages, AirDrop
        and whatever else the reader actually has installed. */}
    <button type="button" class="ts-btn ts-native" data-share-native aria-label="Share…">
      <Icon name="bi:share-fill" class="size-5" />
    </button>

    {shares.map((s) => (
      <a
        href={s.href}
        aria-label={s.label}
        title={s.label}
        target="_blank"
        rel="noopener noreferrer"
        class="ts-btn"
      >
        <Icon name={s.icon} class="size-5" />
      </a>
    ))}

    {/* Copy link is the most-used share action in practice and needs no platform. */}
    <button type="button" class="ts-btn ts-copy" data-share-copy aria-label="Copy link">
      <Icon name="bi:link-45deg" class="size-5 ts-ico-idle" />
      <Icon name="bi:check-lg" class="size-5 ts-ico-done" />
    </button>

    <span class="ts-toast" data-share-toast role="status" aria-live="polite"></span>
  </div>
</div>

<style>
  /* Its own block on a tinted card, not a right-aligned afterthought sharing a
     row with the tag list. At the end of a long read this is the moment the
     reader decides whether to pass it on, so it gets the weight of a call to
     action rather than of a footer. */
  .ts-share {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin: 28px 0;
    padding: 16px 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }
  .ts-prompt {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-dark);
    line-height: 1.4;
  }
  .ts-row {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  .ts-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px everywhere, not only on the narrow breakpoint below. These are the only controls
       on the page besides the notes fold, and a 40px target fails the check at every width. */
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    background: #fff;
    color: var(--color-navy);
    cursor: pointer;
    border-radius: 999px;
    transition: color .15s ease, background-color .15s ease, border-color .15s ease;
  }
  .ts-btn:hover {
    background: var(--color-brand-600);
    border-color: var(--color-brand-600);
    color: #fff;
  }
  .ts-btn:focus-visible { outline: 2px solid var(--color-brand-600); outline-offset: 1px; }

  /* 32px is fine for a mouse and too small for a thumb — these sit shoulder to
     shoulder, so a mis-tap sends the article to the wrong app. Keyed on pointer
     type rather than width, since that is the actual constraint. Eight targets
     at 44px still fit a 375px screen, and wrap if they ever do not. */
  @media (pointer: coarse) {
    .ts-btn { width: 44px; height: 44px; }
  }

  /* On a phone the prompt and the row each take the full width rather than
     competing for one line. */
  @media (max-width: 560px) {
    .ts-share { flex-direction: column; align-items: flex-start; padding: 14px 14px 16px; }
    .ts-prompt { font-size: 14.5px; }
  }

  /* Scoped, so this beats the utility classes and the button cannot flash
     visible before the script runs. */
  .ts-native { display: none; }
  .ts-native.is-on { display: inline-flex; }

  .ts-ico-done { display: none; }
  .ts-copy.is-done .ts-ico-idle { display: none; }
  .ts-copy.is-done .ts-ico-done { display: inline-block; color: var(--color-brand-600); }

  .ts-toast {
    font-size: 12px;
    color: var(--color-muted);
    white-space: nowrap;
    opacity: 0;
    transition: opacity .15s ease;
  }
  .ts-toast.is-on { opacity: 1; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ts-btn, .ts-toast { transition: none; }
  }
</style>

<script>
  // This component renders twice on an article page (once by the tags, once
  // lower down), so every lookup is by class within its own root — ids would
  // collide and only the first instance would work.
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((root) => {
    const url = root.dataset.shareUrl || location.href;
    const title = root.dataset.shareTitle || document.title;

    // A bare call site rendered these links with no title at build time;
    // upgrade them from the page's own title so the share text reads properly.
    if (!root.dataset.shareTitle && title) {
      const u = encodeURIComponent(url);
      const t = encodeURIComponent(title);
      root.querySelectorAll<HTMLAnchorElement>('a.ts-btn').forEach((a) => {
        const l = a.getAttribute('aria-label') || '';
        if (l.includes('WhatsApp')) a.href = `https://api.whatsapp.com/send?text=${t}%20${u}`;
        else if (l.includes('Telegram')) a.href = `https://t.me/share/url?url=${u}&text=${t}`;
        else if (l.includes('on X')) a.href = `https://x.com/intent/post?url=${u}&text=${t}`;
        else if (l.includes('email')) a.href = `mailto:?subject=${t}&body=${t}%0A%0A${u}`;
      });
    }
    const toast = root.querySelector<HTMLElement>('[data-share-toast]');
    let timer: ReturnType<typeof setTimeout>;

    const say = (msg: string) => {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('is-on');
      clearTimeout(timer);
      timer = setTimeout(() => {
        toast.classList.remove('is-on');
        toast.textContent = '';
      }, 2000);
    };

    const native = root.querySelector<HTMLButtonElement>('[data-share-native]');
    if (native && typeof navigator.share === 'function') {
      native.classList.add('is-on');
      native.addEventListener('click', async () => {
        try {
          await navigator.share({ title, url });
        } catch {
          // Dismissing the sheet rejects with AbortError. Not an error worth
          // reporting to the reader.
        }
      });
    }

    const copy = root.querySelector<HTMLButtonElement>('[data-share-copy]');
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copy.classList.add('is-done');
        say('Link copied');
        setTimeout(() => copy.classList.remove('is-done'), 2000);
      } catch {
        say('Press Ctrl+C to copy');
      }
    });
  });
</script>
