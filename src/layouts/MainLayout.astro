---
import Header from '@src/components/Header.astro';
import Footer from '@src/components/Footer.astro';
import BackToTop from '@src/components/BackToTop.astro';
import { Font } from "astro:assets";
import type { HeaderData } from '@src/data/headerData';
import type { FooterData } from '@src/data/footerData';
import '@src/styles/style.css';

/** Passed by article pages so the head can describe a post rather than a
 *  generic page: correct og:type, the post's own cover as the share image,
 *  and BlogPosting structured data. Omitted everywhere else. */
export interface ArticleMeta {
  headline:   string;
  published:  string;
  modified?:  string;
  authorName: string;
  authorUrl:  string;
  image?:     string;
  section?:   string;
  /** Root-relative URL of the section's category page, e.g. "/invest-better".
   *  Feeds the BreadcrumbList schema; omit and the trail is Home → article. */
  sectionUrl?: string;
  tags?:      string[];
}

interface Props {
  title?: string;
  description?: string;
  headerData?: Partial<HeaderData>;
  footerData?: Partial<FooterData>;
  article?: ArticleMeta;
}

const {
  title       = 'Portal - Astro News Magazine Theme',
  description = 'Portal is a Astro news magazine theme. This demo is crafted specifically to exhibit the use of the theme as a blog site. Visit our main page for more demos.',
  headerData  = {},
  footerData  = {},
  article,
} = Astro.props;

const site = Astro.site ?? new URL('https://theenoughpoint.com');
const canonical = Astro.url?.href || site.href;
// Link previews must never be handed an SVG: WhatsApp, Facebook, LinkedIn and
// X all refuse to render one, and they do not degrade to the title — the share
// collapses to a bare URL. Article covers are SVG, so map them to the JPEG twin
// that `npm run og:images` generates, and fall back to the house image if that
// twin is somehow missing.
const rasterCover = article?.image?.endsWith('.svg')
  ? article.image.replace('/img/brand/', '/img/brand/og/').replace(/\.svg$/, '.jpg')
  : article?.image;
const shareImage = new URL(rasterCover ?? '/img/brand/og-image.jpg', site).href;
const shareImageAlt = article?.headline ?? 'TheEnoughPoint';

// Search engines had nothing to work with before this: no schema of any kind
// shipped on any page. For finance writing that matters more than usual, since
// authorship and dating are what Google weighs on the subject.
const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: article.headline,
      description,
      image: shareImage,
      datePublished: article.published,
      dateModified: article.modified ?? article.published,
      author: { '@type': 'Person', name: article.authorName, url: new URL(article.authorUrl, site).href },
      publisher: {
        '@type': 'Organization',
        name: 'TheEnoughPoint',
        url: site.href,
        logo: { '@type': 'ImageObject', url: new URL('/img/brand/og-image.jpg', site).href },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      ...(article.section ? { articleSection: article.section } : {}),
      ...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
      inLanguage: 'en-SG',
      isAccessibleForFree: true,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'TheEnoughPoint',
      url: site.href,
      inLanguage: 'en-SG',
    };

// Breadcrumb markup mirrors the visible meta row (category link) so search
// results can show the trail. The last item is the page itself, on the same
// canonical URL the head declares — one URL form everywhere.
// Directory-built pages canonicalise with a trailing slash; the breadcrumb
// must use that same form or the schema argues with the canonical tags.
const withSlash = (href) => (href.endsWith('/') ? href : href + '/');
const crumbTail = article?.section && article?.sectionUrl
  ? [{ name: article.section, item: withSlash(new URL(article.sectionUrl, site).href) }]
  : [];
const breadcrumb = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: 'Home', item: site.href },
        ...crumbTail,
        { name: article.headline, item: canonical },
      ].map((c, i) => ({ '@type': 'ListItem', position: i + 1, ...c })),
    }
  : null;

// A standalone Organization node belongs on one page only — the homepage —
// so crawlers find a single authoritative record rather than one per page.
// No sameAs: the footer's social links are placeholders, and schema pointing
// at profiles that do not exist is worse than none.
const organization = Astro.url.pathname === '/'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'TheEnoughPoint',
      url: site.href,
      logo: { '@type': 'ImageObject', url: new URL('/img/brand/og-image.jpg', site).href },
    }
  : null;

const schemaBlocks = [schema, breadcrumb, organization].filter(Boolean);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/img/favicon.png" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="TheEnoughPoint" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:secure_url" content={shareImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified ?? article.published} />}
    {article && <meta property="article:author" content={article.authorName} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(schemaBlocks.length === 1 ? schemaBlocks[0] : schemaBlocks)} />

    <slot name="head" />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-body" preload />
  </head>
  <body class="text-slate-700 font-sans" x-data="{ navtoggle: false }">
    <Header data={headerData} />
    <main>
      <slot />
    </main>
    <Footer data={footerData} />
    <BackToTop />
    <script>
      import Alpine from 'alpinejs';
      declare global {
        interface Window { Alpine: typeof Alpine; }
      }
      window.Alpine = Alpine;
      Alpine.start();
    </script>
  </body>
</html>
